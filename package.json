{
  "name": "dm-tool",
  "version": "2.0.0",
  "private": true,
  "description": "A local-first tabletop campaign workspace.",
  "main": "backend/server.js",
  "scripts": {
    "build": "npm run build:css",
    "build:css": "tailwindcss -c tailwind.config.js -i frontend/input.css -o frontend/tailwind.css --minify",
    "start": "node backend/server.js",
    "dev": "node --watch backend/server.js",
    "check": "node --check backend/server.js && node --check frontend/app.js",
    "test": "npm run check"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "express": "^5.2.1"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.17"
  }
}
